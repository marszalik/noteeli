# ── Core ────────────────────────────────────────────────────────────
NOTEELI_CONTENT_ROOT=./content
NOTEELI_DATA_DIR=./.noteeli
NOTEELI_SESSION_SECRET=change-this-secret-before-deploy

# ── Google OAuth ────────────────────────────────────────────────────
NOTEELI_GOOGLE_CLIENT_ID=
NOTEELI_GOOGLE_CLIENT_SECRET=
# Comma-separated list of Google emails allowed to log in.
#   Example: NOTEELI_ALLOWED_GOOGLE_EMAILS=alice@gmail.com,bob@gmail.com
#   Use COMMAS to separate (spaces alone don't work). Whitespace and quotes
#   around items are fine. Restart the service after editing.
#   NOTE: when EMPTY, nobody can log in with Google — set at least one
#   email, or use the password login below.
NOTEELI_ALLOWED_GOOGLE_EMAILS=alice@gmail.com,bob@gmail.com

# ── Built-in password login ─────────────────────────────────────────
# Leave both empty to disable this login method.
NOTEELI_LOCAL_USERNAME=admin
NOTEELI_LOCAL_PASSWORD=changeme

# ── Locked workspace (sharing one directory with a group) ───────────
# When 1, the storage source + root are pinned: users can't change the
# source / content root / SFTP settings, the Settings "Source" tab is
# hidden, and the directory picker is confined to the workspace root
# (no walking up the disk, no repointing the workspace). Pair with the
# email allowlist above to give a group access to exactly one directory.
NOTEELI_LOCK_WORKSPACE=

# ── Reverse proxy ───────────────────────────────────────────────────
# Trust X-Forwarded-Host when deciding whether a request counts as
# "local access" (the no-login path). Leave UNSET for a directly
# exposed instance: otherwise anyone who can reach the port can send
# X-Forwarded-Host: localhost and skip the login page entirely.
# Set to 1 ONLY behind a proxy that overwrites the header — and note
# that if that proxy forwards Host: 127.0.0.1, you MUST set it or every
# visitor is treated as local.
NOTEELI_TRUST_FORWARDED_HOST=
